# ===================================================================
#      .gitignore file for Eclipse Java Projects
#
# Covers Eclipse metadata, build outputs (Maven/Gradle), logs,
# and common OS/editor files.
# ===================================================================

# ### Compiled Java Class Files ###
*.class

# ### Build Output Directories ###
# Default Eclipse output folder
/bin/
# Maven output folder
/target/
# Gradle output folder
/build/
# Other build-related folders
/out/

# ### Packaged Archives ###
# These are generated from your source code
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ### Eclipse Project Files ###
# These are user-specific and regenerated by Eclipse
.project
.classpath
.settings/
.factorypath

# ### Eclipse Workspace Metadata ###
# Should be located outside the project, but added for safety
.metadata/

# ### Maven Files ###
# Maven Eclipse plugin files
.mvn/
# Maven build artifacts
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
dependency-reduced-pom.xml

# ### Gradle Files ###
.gradle/
*.gradletasknamecache

# ### Runtime Files & Logs ###
# Log files
*.log
# JVM crash logs
hs_err_pid*
replay_pid*

# ### IDE-Specific Launch Configurations ###
# These are typically user-specific run/debug settings
*.launch

# ### Operating System Files ###
# Ignore files specific to macOS, Windows, and Linux
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp

# ### Local Properties & Sensitive Files ###
# It's good practice to ignore files that may contain secrets or local paths
# For example, a file for local database passwords
local.properties
*.keystore
